<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<!--
		  PublishAot is intentionally NOT enabled: a full native-AOT publish is currently blocked by
		  reflection inside upstream ToolBX packages (AutoConfig, AutoInject, AssemblyInitializer and
		  Reflection4Humans.TypeFetcher) consumed here as NuGet betas. MisterTerminal's own code is
		  AOT-clean (the library sets IsAotCompatible=true and builds warning-free). Re-enable once
		  those dependencies ship reflection-free, trimming/AOT-safe registration.
		-->
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="appsettings.json" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="appsettings.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="ToolBX.AssemblyInitializer.Console" Version="4.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\MisterTerminal\MisterTerminal.csproj" />
	</ItemGroup>

</Project>
